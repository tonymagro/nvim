" Visual Studio VsVim extension settings

" CTRL-X and SHIFT-Del are Cut
vnoremap <C-X> "+x
vnoremap <S-Del> "+x

" CTRL-C and CTRL-Insert are Copy
vnoremap <C-C> "+y
vnoremap <C-Insert> "+y

" CTRL-V and SHIFT-Insert are Paste
map <C-V>		"+gP
map <S-Insert>		"+gP
imap <C-V>		<Esc>"+gpa

cmap <C-V>		<C-R>+
cmap <S-Insert>		<C-R>+


imap <S-Insert>		<C-V>
vmap <S-Insert>		<C-V>

" Use CTRL-Q to do what CTRL-V used to do
noremap <C-Q>		<C-V>

" set 'selection', 'selectmode', 'mousemodel' and 'keymodel' for MS-Windows
" behave mswin

" backspace and cursor keys wrap to previous/next line
"set backspace=indent,eol,start whichwrap+=<,>,[,]

" backspace in Visual mode deletes selection
vnoremap <BS> d

" Sometimes slow, see https://github.com/VsVim/VsVim/issues/2035
set clipboard=unnamed " yank to clipboard
" Workaround for slow copy
" noremap y "*y
" noremap yy "*yy
" noremap Y "*y$
" noremap d "*d
" noremap dd "*dd
" noremap D "*D
" noremap p "*p
" noremap P "*P
" black hole register for x because chars do not need to go in any accessible register anyway
"a noremap x "_x

set vb
